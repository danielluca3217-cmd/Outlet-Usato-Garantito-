# Copia questi nomi (NON i valori) nelle "Variables" del progetto su Railway.
# Non caricare mai un file .env vero su Git.

# DATABASE_URL non va impostata a mano: quando colleghi il plugin
# PostgreSQL al servizio su Railway (New -> Database -> Add PostgreSQL,
# poi "Add Reference" nelle Variables del servizio backend), Railway la
# crea e la collega da solo.

DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
IMGBB_API_KEY=la_tua_key_imgbb
ADMIN_PASSWORD=scegli_una_password_forte_nuova

# Variabili sotto usate SOLO una volta, per lo script migra-da-jsonbin.js
# (poi puoi cancellarle, non servono più al server):
# JSONBIN_BIN_ID=6a8836b0f5f4af5e2930f4bb
# JSONBIN_API_KEY=la_tua_master_key_jsonbin
